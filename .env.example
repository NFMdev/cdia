GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
VITE_API_BASE_URL=/api
VITE_USE_MOCK_API=false
VITE_ENABLE_HEATMAP=true
VITE_FILTER_BY_BBOX=false
