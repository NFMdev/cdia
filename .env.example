POSTGRES_DB=cdia
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=change_me_superpass
ELASTIC_PASSWORD=test
UNSAFE_DEMO_MODE=false
CDIA_BIND_HOST=127.0.0.1
CDIA_APP_DB_USER=cdia_app
CDIA_APP_DB_PASSWORD=change_me_app
CDIA_MIGRATIONS_DB_USER=cdia_migrations
CDIA_MIGRATIONS_DB_PASSWORD=change_me_migrations
CDIA_METRICS_DB_USER=cdia_metrics
CDIA_METRICS_DB_PASSWORD=change_me_metrics
CDIA_SEARCH_BASE_URL=http://search-service:8085
CDIA_SEARCH_INDEXING_ENABLED=true
CDIA_SEARCH_INDEXING_MAX_ATTEMPTS=3
CDIA_SEARCH_INDEXING_RETRY_BACKOFF_MS=200
POSTGRES_SLOT_NAME=flink
POSTGRES_STARTUP_MODE=latest
ES_HOSTS=http://cdia-elasticsearch:9200
ES_USERNAME=elastic
ES_INDEX_EVENT_ANOMALIES=event-anomalies
